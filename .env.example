# Database
DATABASE_URI=mongodb+srv://user:password@cluster.mongodb.net/l27

# Payload CMS
PAYLOAD_SECRET=your-secret-key-min-32-chars

# Public URL
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# S3 Storage
S3_BUCKET=your-bucket-name
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=ru-1
S3_ENDPOINT=https://s3.twcstorage.ru

SMTP_HOST=
SMTP_USER=
SMTP_PASS=

# Итоги сезона: ключ нужен только скрипту npm run recap:generate, сайт OpenRouter не вызывает
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-haiku-4.5
# Если OpenRouter недоступен напрямую — адрес прокси и его секрет (заголовок X-Relay-Secret)
OPENROUTER_BASE_URL=
OPENROUTER_RELAY_SECRET=